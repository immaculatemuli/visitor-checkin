# API base path. Keep "/api" and proxy it (vite.config.ts in dev, vercel.json / netlify.toml in production)
# so cookies stay first-party. Only set a full URL if you deliberately serve the API cross-site.
VITE_API_BASE=/api

# Public URL encoded in the reception QR poster and pass QR codes. Defaults to the current origin.
# VITE_PUBLIC_URL=https://visitors.example.go.ke
