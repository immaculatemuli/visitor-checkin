# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nys_visitors?schema=public"
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Keys the document-number hashes. Never change it after go-live or existing visitors/watchlist won't match.
DOC_HASH_SECRET="replace-with-a-different-long-random-string"
# Browser origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN="http://localhost:5173"

# --- Optional ---
NODE_ENV=development
PORT=4000
# Secure cookies (defaults to true when NODE_ENV=production)
# COOKIE_SECURE=true
# Reverse proxies in front of the API: Render only = 1, Vercel/Netlify rewrite -> Render = 2
TRUST_PROXY=1
# Optional institution name shown in the consent notice and on exports
ORG_NAME=""
# Shown in the data-protection notice, e.g. "dpo@example.go.ke"
DPO_CONTACT=""
TIMEZONE=Africa/Nairobi
# Visits still open after this time get flagged
END_OF_DAY_TIME=18:00
# Visit records older than this are deleted automatically
RETENTION_MONTHS=12
AUDIT_RETENTION_MONTHS=24
ENABLE_JOBS=true

# SMS for returning-visitor OTP. "console" prints codes to the server log (development only).
SMS_PROVIDER=console
# SMS_PROVIDER=africastalking
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=

# Seed (prisma/seed.ts)
# SEED_ADMIN_EMAIL=admin@checkin.local
# SEED_ADMIN_PASSWORD=ChangeMe2026!
